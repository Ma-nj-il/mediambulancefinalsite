# RESQ Nepal — placeholders only. Never commit real secrets.
# Frontend (safe to expose): Supabase project URL + publishable key.
VITE_SUPABASE_URL=https://your-project.example
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (never use a VITE_ prefix, never commit):
# Used by src/integrations/supabase/client.server.ts and scripts/seed-admin.ts
SUPABASE_URL=https://your-project.example
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-never-commit

# Initial admin seed — development only. Run once: bun scripts/seed-admin.ts
# The seeded admin is flagged must_change_password and must replace this before production.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me-use-a-strong-password
